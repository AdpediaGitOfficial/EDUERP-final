  vehicle_id     String         @db.Uuid
  doc_kind       String
  title          String
  file_path      String?
  issue_date     DateTime?      @db.Date
  expiry_date    DateTime?      @db.Date
  uploaded_by    String?        @db.Uuid
  notes          String?
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  users          users?         @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)
  fleet_vehicles fleet_vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiry_date], map: "idx_vehicle_documents_expiry")
  @@index([vehicle_id], map: "idx_vehicle_documents_vehicle")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vehicle_maintenance {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id     String         @db.Uuid
  service_date   DateTime       @db.Date
  service_type   String
  cost           Decimal        @default(0) @db.Decimal(12, 2)
  vendor         String?
  next_due_date  DateTime?      @db.Date
  notes          String?
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  fleet_vehicles fleet_vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

