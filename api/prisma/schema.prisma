model hr_employment_types {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model hr_pay_grades {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String   @unique
  level      Int      @default(1)
  min_salary Decimal? @db.Decimal
  max_salary Decimal? @db.Decimal
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model hr_leave_types {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  code          String   @unique
  annual_quota  Int      @default(0)
  is_paid       Boolean  @default(true)
  carry_forward Boolean  @default(false)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model hr_salary_templates {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  code        String                  @unique
  description String?
  basic       Decimal                 @default(0) @db.Decimal(12, 2)
  earnings    Json                    @default("[]")
  deductions  Json                    @default("[]")
  pf_enabled  Boolean                 @default(true)
  esi_enabled Boolean                 @default(true)
  pt_enabled  Boolean                 @default(true)
  tds_enabled Boolean                 @default(false)
  tds_amount  Decimal                 @default(0) @db.Decimal(12, 2)
  is_active   Boolean                 @default(true)
  created_at  DateTime                @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                @default(now()) @db.Timestamptz(6)
  structures  hr_salary_structures[]

  @@schema("public")
}

model hr_salary_structures {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id       String               @unique @db.Uuid
  template_id    String?              @db.Uuid
  basic          Decimal              @default(0) @db.Decimal(12, 2)
  earnings       Json                 @default("[]")
  deductions     Json                 @default("[]")
  pf_enabled     Boolean              @default(true)
  esi_enabled    Boolean              @default(true)
  pt_enabled     Boolean              @default(true)
  tds_enabled    Boolean              @default(false)
  tds_amount     Decimal              @default(0) @db.Decimal(12, 2)
  effective_from DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes          String?
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @default(now()) @db.Timestamptz(6)
  staff          staff                @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  template       hr_salary_templates? @relation(fields: [template_id], references: [id], onUpdate: NoAction)

  @@index([template_id])
  @@schema("public")
}

model hr_loans {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id      String                @db.Uuid
  loan_type     String                @default("advance")
  principal     Decimal               @db.Decimal(12, 2)
  interest_rate Decimal               @default(0) @db.Decimal(6, 3)
  tenure_months Int                   @default(1)
  reason        String?
  status        String                @default("pending")
  disbursed_on  DateTime?             @db.Date
  approved_by   String?               @db.Uuid
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @default(now()) @db.Timestamptz(6)
  staff         staff                 @relation("hr_loans_staffTostaff", fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approver      staff?                @relation("hr_loans_approverTostaff", fields: [approved_by], references: [id], onUpdate: NoAction)
  repayments    hr_loan_repayments[]

  @@index([staff_id])
  @@index([status])
  @@schema("public")
}

model hr_loan_repayments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loan_id        String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  paid_on        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  installment_no Int?
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  loan           hr_loans @relation(fields: [loan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([loan_id])
  @@schema("public")
}
