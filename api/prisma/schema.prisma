generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model identities {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?   @db.Uuid
  provider_id     String?
  provider        String    @default("email")
  identity_data   Json?     @default("{}")
  last_sign_in_at DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  users           users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("auth")
}

model users {
  instance_id                                                     String?                @db.Uuid
  id                                                              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aud                                                             String?
  role                                                            String?
  email                                                           String?                @unique
  encrypted_password                                              String?
  raw_user_meta_data                                              Json?                  @default("{}")
  raw_app_meta_data                                               Json?                  @default("{}")
  email_confirmed_at                                              DateTime?              @db.Timestamptz(6)
  last_sign_in_at                                                 DateTime?              @db.Timestamptz(6)
  is_super_admin                                                  Boolean?               @default(false)
  phone                                                           String?
  confirmation_token                                              String?                @default("")
  email_change                                                    String?                @default("")
  email_change_token_new                                          String?                @default("")
  recovery_token                                                  String?                @default("")
  created_at                                                      DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                                                      DateTime?              @default(now()) @db.Timestamptz(6)
  identities                                                      identities[]
  announcements                                                   announcements[]
  attendance                                                      attendance[]
  broadcast_recipients                                            broadcast_recipients[]
  broadcasts                                                      broadcasts[]
  classes                                                         classes[]
  complaint_messages                                              complaint_messages[]
  complaints                                                      complaints[]
  driver_incidents                                                driver_incidents[]
  holidays                                                        holidays[]
  homework                                                        homework[]
  payments                                                        payments[]
  permission_audit_log_permission_audit_log_actor_idTousers       permission_audit_log[] @relation("permission_audit_log_actor_idTousers")
  permission_audit_log_permission_audit_log_target_user_idTousers permission_audit_log[] @relation("permission_audit_log_target_user_idTousers")
  progress_notes                                                  progress_notes[]
  staff_permissions                                               staff_permissions[]
  teacher_classes                                                 teacher_classes[]
  timetable                                                       timetable[]
  user_roles                                                      user_roles[]
  vehicle_documents                                               vehicle_documents[]

  @@schema("auth")
}

