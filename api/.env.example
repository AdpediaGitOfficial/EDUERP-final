# PostgreSQL connection (the schema extracted from Supabase — build a fresh one
# locally with api/db/apply-migrations.sh, or point at your migrated instance).
DATABASE_URL="postgresql://erp:erp@localhost:5432/greenwood?schema=public"

# JWT signing secret — required, no default. Generate: openssl rand -base64 48
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# HTTP
API_PORT=3001
# Frontend origin(s) for CORS (comma-separated)
WEB_ORIGIN="http://localhost:8080"
