# ── Supabase (required) ──────────────────────────────────────────────────────
# Point these at the Supabase project you own (Settings → API).
# See README "Backend setup".

# Server-side (SSR + server functions)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Service-role key — server only, bypasses RLS. NEVER expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Client-side (inlined into the browser bundle at build time — publishable values only)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Payments (optional) ──────────────────────────────────────────────────────
# Client token for the payments provider; use a test_ token outside production.
VITE_PAYMENTS_CLIENT_TOKEN="test_..."

# ── Server (optional) ────────────────────────────────────────────────────────
# Port for the production Node server (`bun run start`). Defaults to 3000.
# PORT=3000
# Nitro deployment preset used at build time (defaults to node-server).
# NITRO_PRESET=node-server

# ── NestJS API (backend migration; see BACKEND_MIGRATION_LOG.md) ────────────
# Base URL of the NestJS API. Use "/api" when Nginx proxies it on the same
# origin, or the full origin (e.g. http://localhost:3001/api) in development.
VITE_API_URL="/api"
